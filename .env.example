# AWS API Gateway Endpoint (configured after 'sam deploy' in /aws)
# Leave empty to run in 100% Offline Local Mock Mode
VITE_AWS_API_ENDPOINT=""

# Amazon Bedrock Model ID
BEDROCK_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"

# Target AWS Deployment Region
AWS_REGION="us-east-1"

# Local OpenCV Vision Service WebSocket Port (Default: 8765)
VITE_VISION_WS_URL="ws://localhost:8765"
